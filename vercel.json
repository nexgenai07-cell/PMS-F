{
  "rewrites": [
    {
      "source": "/test-proxy",
      "destination": "https://pmsbackend.nxgenai.pro/api/auth/login/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pmsbackend.nxgenai.pro/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}